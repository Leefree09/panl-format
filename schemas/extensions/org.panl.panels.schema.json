{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panl.org/schemas/extensions/org.panl.panels.schema.json",
  "title": "org.panl.panels",
  "description": "Effective panel layouts for reading. See extensions/official/panels.md.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "source", "pages"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "source": {"type": "string", "enum": ["auto", "manual", "mixed"]},
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["page", "panels"],
        "properties": {
          "page": {"type": "integer", "minimum": 0},
          "readingDirection": {
            "type": "string",
            "enum": ["ltr", "rtl", "ttb", "webtoon"]
          },
          "panels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["id", "order", "bbox"],
              "properties": {
                "id": {"type": "string"},
                "order": {"type": "integer", "minimum": 0},
                "bbox": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {"type": "number", "minimum": 0, "maximum": 1}
                },
                "polygon": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "number", "minimum": 0, "maximum": 1}
                  }
                },
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "source": {"type": "string", "enum": ["auto", "manual"]}
              }
            }
          }
        }
      }
    },
    "custom": {
      "type": "object",
      "additionalProperties": {"type": "object"},
      "propertyNames": {"pattern": "^[a-z][a-z0-9._-]*\\.[a-z0-9._-]+$"}
    }
  }
}
