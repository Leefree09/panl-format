{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panl.org/schemas/extensions/org.panl.page-roles.schema.json",
  "title": "org.panl.page-roles",
  "description": "Per-page classification overrides. See extensions/official/page-roles.md.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "roles"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "roles": {
      "type": "object",
      "description": "Stringified page index -> role string. Pages not listed inherit from the page index.",
      "propertyNames": {"pattern": "^(0|[1-9][0-9]*)$"},
      "additionalProperties": {
        "type": "string",
        "enum": ["cover", "story", "ad", "credits", "backmatter", "watermark", "extra", "unknown"]
      }
    },
    "custom": {
      "type": "object",
      "additionalProperties": {"type": "object"},
      "propertyNames": {"pattern": "^[a-z][a-z0-9._-]*\\.[a-z0-9._-]+$"}
    }
  }
}
