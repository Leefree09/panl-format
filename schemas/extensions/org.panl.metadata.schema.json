{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panl.org/schemas/extensions/org.panl.metadata.schema.json",
  "title": "org.panl.metadata",
  "description": "Bibliographic / comic metadata extension. See extensions/official/metadata.md.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "title": {"type": "string"},
    "series": {"type": "string"},
    "issue": {"type": "string"},
    "volume": {"type": "string"},
    "publisher": {"type": "string"},
    "imprint": {"type": ["string", "null"]},
    "releaseDate": {
      "type": "string",
      "description": "ISO 8601 date, YYYY-MM-DD preferred."
    },
    "description": {"type": "string"},
    "language": {
      "type": "string",
      "description": "ISO 639-1 two-letter code preferred."
    },
    "ageRating": {"type": "string"},
    "characters": {"type": "array", "items": {"type": "string"}},
    "teams":      {"type": "array", "items": {"type": "string"}},
    "locations":  {"type": "array", "items": {"type": "string"}},
    "tags":       {"type": "array", "items": {"type": "string"}},
    "genres":     {"type": "array", "items": {"type": "string"}},
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["role", "names"],
        "properties": {
          "role":  {"type": "string"},
          "names": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "custom": {
      "type": "object",
      "additionalProperties": {"type": "object"},
      "propertyNames": {"pattern": "^[a-z][a-z0-9._-]*\\.[a-z0-9._-]+$"}
    }
  }
}
